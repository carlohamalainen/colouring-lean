[Unit]
Description=Colouring page (Lean + Datastar)
After=network.target

[Service]
Type=simple
# A transient unprivileged user: the program reads nothing from disk and writes nothing.
DynamicUser=yes
WorkingDirectory=/opt/colouring-lean
# Arguments: port, seconds per fade step, bind address.
ExecStart=/opt/colouring-lean/colouring-linux-amd64 8084 0 127.0.0.1
Restart=always
RestartSec=5
# The droplet is shared with other services; past this the app is restarted rather than
# starving them. Each open stream costs about 1.5 MB, and the app allows 200 at once.
MemoryMax=450M

[Install]
WantedBy=multi-user.target
