colouring-lean.hamalainen.dev {
    log {
        output stderr
        format json
    }

    # The app brotli-compresses its own SSE stream when the browser accepts it, so no encode
    # directive here. Caddy flushes text/event-stream responses immediately, which the stream needs.
    reverse_proxy 127.0.0.1:8084

    @hasBody method POST PUT PATCH
    request_body @hasBody {
        max_size 16KB
    }
}
