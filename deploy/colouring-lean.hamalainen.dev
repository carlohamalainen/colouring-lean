colouring-lean.hamalainen.dev {
    log {
        output stderr
        format json
    }

    # No encode directive: the app sends its SSE stream uncompressed for now, and Caddy
    # flushes text/event-stream responses immediately, which the stream needs.
    reverse_proxy 127.0.0.1:8084

    @hasBody method POST PUT PATCH
    request_body @hasBody {
        max_size 16KB
    }
}
